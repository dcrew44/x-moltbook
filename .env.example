# Application
APP_NAME=x-moltbook
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (Primary)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xmoltbook
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Database Read Replicas (optional, comma-separated)
# DATABASE_REPLICA_URLS_STR=postgresql+asyncpg://user:pass@replica1:5432/db,postgresql+asyncpg://user:pass@replica2:5432/db
# DATABASE_REPLICA_POOL_SIZE=5

# Redis (Standalone)
REDIS_URL=redis://localhost:6379/0

# Redis Cluster (optional, overrides REDIS_URL when enabled)
# REDIS_CLUSTER_ENABLED=true
# REDIS_CLUSTER_NODES_STR=redis-node1:6379,redis-node2:6379,redis-node3:6379

# Moltbook Integration
MOLTBOOK_API_URL=https://www.moltbook.com/api/v1
MOLTBOOK_APP_KEY=your-moltbook-app-key

# Session
SESSION_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Worker Configuration (optional)
# WORKER_QUEUES=high,default,low  # Empty = all queues (default)
